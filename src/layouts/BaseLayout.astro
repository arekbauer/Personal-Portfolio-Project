---
interface Props {
  title?: string;
  description?: string;
  extraStylesheet?: string;
}

const {
  title = "Arkadiusz Bauer",
  description = "Arkadiusz Bauer — software engineer and Android consultant in Manchester.",
  extraStylesheet,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/static/portfolio/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@400;500;600;700;800&family=Roboto+Flex:opsz,slnt,wdth,wght@8..144,-10..0,75..125,300..900&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous" />
    <link rel="stylesheet" href="/static/portfolio/css/home.css" />
    <link rel="stylesheet" href="/static/portfolio/css/about-me.css" />
    <link rel="stylesheet" href="/static/portfolio/css/projects.css" />
    {extraStylesheet && <link rel="stylesheet" href={extraStylesheet} />}
    <title>{title}</title>
  </head>
  <body>
    <header class="header">
      <h3><a class="brand" href="/">Arkadiusz Bauer</a></h3>
      <nav class="navbar" aria-label="Main navigation">
        <input type="checkbox" id="sidebar-active" />
        <label for="sidebar-active" class="open-sidebar-button" aria-label="Open navigation">
          <svg xmlns="http://www.w3.org/2000/svg" height="32" viewBox="0 -960 960 960" width="32" fill="#64ffda"><path d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z" /></svg>
        </label>
        <label id="overlay" for="sidebar-active"></label>
        <div class="links-container">
          <label for="sidebar-active" class="close-sidebar-button" aria-label="Close navigation">
            <svg xmlns="http://www.w3.org/2000/svg" height="32" viewBox="0 -960 960 960" width="32" fill="#64ffda"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z" /></svg>
          </label>
          <a href="/#about" data-section="about">Home</a>
          <a href="/#projects" data-section="projects">Projects</a>
          <button id="theme-switch" type="button" aria-label="Toggle colour theme">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><path d="M120 40V16a8 8 0 0 1 16 0v24a8 8 0 0 1-16 0m72 88a64 64 0 1 1-64-64a64.07 64.07 0 0 1 64 64m-16 0a48 48 0 1 0-48 48a48.05 48.05 0 0 0 48-48M58.34 69.66a8 8 0 0 0 11.32-11.32l-16-16a8 8 0 0 0-11.32 11.32Zm0 116.68l-16 16a8 8 0 0 0 11.32 11.32l16-16a8 8 0 0 0-11.32-11.32M192 72a8 8 0 0 0 5.66-2.34l16-16a8 8 0 0 0-11.32-11.32l-16 16A8 8 0 0 0 192 72m5.66 114.34a8 8 0 0 0-11.32 11.32l16 16a8 8 0 0 0 11.32-11.32ZM48 128a8 8 0 0 0-8-8H16a8 8 0 0 0 0 16h24a8 8 0 0 0 8-8m80 80a8 8 0 0 0-8 8v24a8 8 0 0 0 16 0v-24a8 8 0 0 0-8-8m112-88h-24a8 8 0 0 0 0 16h24a8 8 0 0 0 0-16" /></svg>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><path d="M233.54 142.23a8 8 0 0 0-8-2 88.08 88.08 0 0 1-109.8-109.8 8 8 0 0 0-10-10A104 104 0 1 0 235.52 150a8 8 0 0 0-1.98-7.77m-44.64 48.11A88 88 0 0 1 65.66 67.11a89 89 0 0 1 31.4-26A104 104 0 0 0 214.92 158.94a89 89 0 0 1-26.02 31.4" /></svg>
          </button>
        </div>
      </nav>
    </header>
    <slot />
    <footer class="footer"><p>&copy; {new Date().getFullYear()} Arek Bauer. All rights reserved.</p></footer>
    <script is:inline type="module" src="/static/portfolio/js/on-reload.js"></script>
    <script is:inline src="/static/portfolio/js/spotify-widget.js" defer></script>
  </body>
</html>

<style>
  .brand { color: inherit; }
  .brand:hover { color: var(--accent-color); }
</style>
